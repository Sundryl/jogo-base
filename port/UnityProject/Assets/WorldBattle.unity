--- !u!114 &29780
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4965}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 1453722849, guid: 67dfb1fdfb2b407222eda8e23ac8b724, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<font=\"TW-Kai-98_1 SDF\">三点水余,Proselyte,<font=\"TW-Kai-98_1 SDF\">十八星,Karolus pratus,<font=\"TW-Kai-98_1 SDF\">静玄,<font=\"TW-Kai-98_1 SDF\">葭栖,<font=\"TW-Kai-98_1 SDF\">皓月当空,ArizonaClinton,<font=\"TW-Kai-98_1 SDF\">灰熊,<font=\"TW-Kai-98_1 SDF\">辰鹤,<font=\"TW-Kai-98_1 SDF\">掌盟人,Starson,Smmfp,<font=\"TW-Kai-98_1 SDF\">磕咖啡因caffeine,<font=\"TW-Kai-98_1 SDF\">华章,Gundam,<font=\"TW-Kai-98_1 SDF\">王枫,<font=\"TW-Kai-98_1 SDF\">极限战士（甜甜圈）,<font=\"TW-Kai-98_1 SDF\">斯尔龙猫,K,<font=\"TW-Kai-98_1 SDF\">冬日暖羊,<font=\"TW-Kai-98_1 SDF\">心若芷萱,<font=\"TW-Kai-98_1 SDF\">漓江,<font=\"TW-Kai-98_1 SDF\">两杠一括是加号,<font=\"TW-Kai-98_1 SDF\">北极的熊,<font=\"TW-Kai-98_1 SDF\">急了,<font=\"TW-Kai-98_1 SDF\">豆子,<font=\"TW-Kai-98_1 SDF\">敦朱土拨鼠,<font=\"TW-Kai-98_1 SDF\">若一,<font=\"TW-Kai-98_1 SDF\">白火,Pistoletoff,Zawod Roshen,Dwemey,Alan Von Finster-Wittgenstein,Fallenjamjam,Snorlax,awak,mapledev,<font=\"TW-Kai-98_1 SDF\">丰川祥子（玩家）,<font=\"TW-Kai-98_1 SDF\">椎名立希（玩家）,<font=\"TW-Kai-98_1 SDF\">苏莫,<font=\"TW-Kai-98_1 SDF\">御风飞行的nagasaki,snowy_light,<font=\"TW-Kai-98_1 SDF\">悠然于南山,<font=\"TW-Kai-98_1 SDF\">米沙,<font=\"TW-Kai-98_1 SDF\">黄小嘎\n<font=\"TW-Kai-98_1 SDF\">\n另外，我们要单独纪念一下 心若芷萱，她是一名杰出的社区贡献者，在游戏发售后，承担了大量的社区管理工作，在创意工坊中，也有很多她制作的 mod 与地图。她于 2025 年8月 28 日告别了这个世界，希望她在另外一个世界也能过得快乐，幸福。</font>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d7e6e81d6d5c86245b4577d7d5302710, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: a1d694cf08390b44b9cfc4d8c31013b9, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
