  m_text: "指令说明\n<align=center><color=#FF0000>加入</color><color=#000000> + </color><color=#0000FF>数字</color>     <color=#000000>加入对应阵营</color></align>\r\n<align=center><color=#FF0000>结盟</color><color=#000000> + </color><color=#0000FF>数字</color> <color=#000000>向对应阵营结盟</color></align>\r\n<align=center><color=#FF0000>进攻</color><color=#000000> + </color><color=#0000FF>数字</color> <color=#000000>向对应玩家宣战</color></align>\r\n<align=center><color=#FF0000>停战</color><color=#000000> + </color><color=#0000FF>数字</color>     <color=#000000>停止对应战争</color></align>\r\n<align=center><color=#FF0000>同意停战           </color><color=#000000><color=#000000>同意停战请求</color></align>\r\n<align=center><color=#FF0000>同意结盟           </color><color=#000000><color=#000000>同意结盟请求</color></align>\r\n<align=center><color=#FF0000>进攻全部                </color><color=#000000>      <color=#000000>进攻全部</color></align>\r\n<align=center><color=#FF0000>退出结盟</color><color=#0000FF>            退出所有结盟</color></align>"
